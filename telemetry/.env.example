# Copy to .env on the VM if you want a local note. Do not commit .env.
# docker-compose.yml does not read these variables. They are reference only.
BNAV_TELEMETRY_HOST=telemetry.example.com
# TLS files live in ./certs/tls.crt (full chain) and ./certs/tls.key.
# Neither file is committed. See .gitignore.
# Application public key is hosted separately, and must stay reachable, at:
# https://<app-domain>/.well-known/appspecific/com.tesla.3p.public-key.pem
# The private key and partner tokens never go in this folder or in git.
