# Copy to .env on the VM. Do not commit secrets.
# Documentation only: records the public telemetry FQDN. docker-compose.yml and
# config.json do not read this variable; use this FQDN as the hostname in
# fleet_telemetry_config and on the TLS cert.
BNAV_TELEMETRY_HOST=telemetry.example.com
# TLS files live in ./certs/tls.crt and ./certs/tls.key
# Application public key is hosted separately at:
# https://<app-domain>/.well-known/appspecific/com.tesla.3p.public-key.pem
