# Copy to .env on the VM. Do not commit secrets.
# Note: docker-compose.yml does not currently read these variables; they are for your reference only.
BNAV_TELEMETRY_HOST=telemetry.example.com
# TLS files live in ./certs/tls.crt (full chain) and ./certs/tls.key
# Application public key is hosted separately at:
# https://<app-domain>/.well-known/appspecific/com.tesla.3p.public-key.pem
# The PRIVATE key never goes on this box's web root or in this folder's git history.
