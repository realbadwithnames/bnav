{
  "host": "0.0.0.0",
  "port": 443,
  "status_port": 8080,
  "log_level": "info",
  "json_log_enable": true,
  "namespace": "bnav",
  "reliable_ack": false,
  "transmit_decoded_records": true,
  "logger": {
    "verbose": true
  },
  "rate_limit": {
    "enabled": true,
    "message_interval_time": 30,
    "message_limit": 1000
  },
  "records": {
    "alerts": ["logger"],
    "errors": ["logger"],
    "V": ["logger"],
    "connectivity": ["logger"]
  },
  "tls": {
    "server_cert": "/etc/certs/server/tls.crt",
    "server_key": "/etc/certs/server/tls.key"
  }
}
